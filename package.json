{
  "name": "noaa-us-weather-radar-app",
  "author": "newts",
  "version": "2.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10",
    "pako": "^1.0.11",
    "upng-js": "^2.1.0"
  },
  "pebble": {
    "displayName": "NOAA Radar Zoom",
    "uuid": "7d0cc50d-e4a0-4cb4-9ec6-1329216d8ea0",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "basalt",
      "gabbro",
      "chalk"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "location",
      "configurable"
    ],
    "messageKeys": [
      "IMG_TOTAL",
      "IMG_OFFSET",
      "IMG_DATA",
      "REQUEST_IMAGES",
      "RADAR_TIME",
      "CMD",
      "ZOOM_KM",
      "RADAR_MODE",
      "BUSY"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true,
          "memoryFormat": "1Bit",
          "storageFormat": "pbi"
        }
      ]
    }
  }
}
